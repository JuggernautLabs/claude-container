#!/usr/bin/env bash
# Spawn into a Docker container with Claude Code ready to execute
#
# Usage:
#   claude-container -s <session> [options]
#   claude-container -s myproj                    # Single project from cwd
#   claude-container -s myproj -a ~/repo1 -a ~/repo2  # Multiple projects
#   claude-container -s myproj --discover-repos ~/dev  # Auto-discover repos
#
# Environment:
#   CLAUDE_CODE_OAUTH_TOKEN  OAuth token for authentication (required)

set -e

VERSION="0.2.0"
DEFAULT_IMAGE="ghcr.io/hypermemetic/claude-container:latest"
GIT_UTIL_IMAGE="alpine/git"  # Lightweight image for utility ops (bundle, config, manifest)

# Config and cache directories
CONFIG_DIR="$HOME/.config/claude-container"
CACHE_DIR="$CONFIG_DIR/cache"

# Ensure directories exist
mkdir -p "$CONFIG_DIR" "$CACHE_DIR"
chmod 700 "$CONFIG_DIR"

# Clean up stale token directories (Docker Desktop race condition can create these)
for _stale_token in "$CACHE_DIR"/token-*; do
    [[ -d "$_stale_token" ]] && rm -rf "$_stale_token"
done

# Source library modules (resolve symlinks to find actual script location)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
source "$SCRIPT_DIR/lib/utils.sh"
source "$SCRIPT_DIR/lib/platform.sh"
source "$SCRIPT_DIR/lib/container-detect.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/auth.sh"
source "$SCRIPT_DIR/lib/docker.sh"
source "$SCRIPT_DIR/lib/git-session.sh"
source "$SCRIPT_DIR/lib/merge-detect.sh"
source "$SCRIPT_DIR/lib/session-mgmt.sh"
source "$SCRIPT_DIR/lib/session-discovery.sh"

# Global state variables
DOCKERFILE=""
SESSION_DIR=""
VERIFY_MODE=false
SESSION_NAME=""
SESSION_NAME_SET=false
USE_GIT_SESSION=true  # Default: use git-based session isolation
CONTINUE_SESSION=false
RUN_AS_USER=false
RUN_AS_ROOTISH=true  # Default: run as user with passwordless sudo for package installs
NO_RUN=false
SHELL_ONLY=false
BASH_EXEC=""  # Command to execute instead of claude
ENABLE_DOCKER=false  # Mount Docker socket for host Docker access
CONFIG_ONLY=false    # Just generate config, don't create session
DISCOVER_REPOS_DIRS=()  # Array for multiple --discover-repos
ADD_REPOS=()  # Array for repos to add via --add-repo
SESSIONS_CONFIG_DIR="$CONFIG_DIR/sessions"  # Where session configs are stored
CLAUDE_ARGS=()  # Arguments to pass through to claude
NO_INTERACTIVE=false  # Fail fast if no token found (don't start OAuth flow)
NO_CONFIG=false       # Skip auto-discovery of .claude-projects.yml
MERGE_INTO_BRANCH=""  # Branch to merge into session (--merge-into)
AUTO_MERGE=false      # Auto-merge session back into target (--auto-merge)
AUTO_MERGE_BRANCH=""  # Target branch for auto-merge (default: main)
CLONE_FROM=""         # Clone volumes from existing session (--clone-from)
DIRTY_SESSION=false   # Capture host uncommitted changes into session (--dirty)
EXPOSE_PORTS=()       # Ports to expose (--port)
EPHEMERAL=false       # --ephemeral: destroy container on exit (old default)
REBUILD_CONTAINER=false  # --rebuild: force-remove existing container and create fresh

# Tracking booleans for CLI-set flags (for session metadata override logic)
NO_CONFIG_SET=false
RUN_AS_USER_SET=false
RUN_AS_ROOTISH_SET=false
ENABLE_DOCKER_SET=false
DOCKERFILE_SET=false

# Docker args accumulators
declare -a DOCKER_ARGS
declare -a EXTRA_DOCKER_ARGS  # Populated by pre-startup actions (e.g. merge-into)

# Action flags (only one action can be performed at a time)
ACTION=""
ACTION_FORCE=false
ACTION_YES=false
ACTION_REGEX=false
IMPORT_SOURCE=""
REMOVE_UNDISCOVERED=false

# Subcommand dispatch — if first arg is a known command, delegate to it
if [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; then
    _subcmd="$1"
    if [[ -d "$SCRIPT_DIR/lib/commands/${_subcmd}" ]]; then
        shift
        for _f in "$SCRIPT_DIR/lib/commands/${_subcmd}"/*.sh; do
            source "$_f"
        done
        _subcmd_rc=0
        "cmd_${_subcmd}" "$@" || _subcmd_rc=$?
        exit $_subcmd_rc
    elif [[ -f "$SCRIPT_DIR/lib/commands/${_subcmd}.sh" ]]; then
        shift
        source "$SCRIPT_DIR/lib/commands/${_subcmd}.sh"
        _subcmd_rc=0
        "cmd_${_subcmd}" "$@" || _subcmd_rc=$?
        exit $_subcmd_rc
    fi
fi

# Helper: enforce mutual exclusion on action flags
_set_action() {
    if [[ -n "$ACTION" ]]; then
        error "Cannot combine --$1 with --$ACTION"
        exit 1
    fi
    ACTION="$1"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dir|-d)
            SESSION_DIR="$2"
            shift 2
            ;;
        --verify|-v)
            VERIFY_MODE=true
            shift
            ;;
        --session|-s)
            SESSION_NAME="$2"
            SESSION_NAME_SET=true
            shift 2
            ;;
        --no-git-session)
            USE_GIT_SESSION=false
            shift
            ;;
        --config-only)
            CONFIG_ONLY=true
            shift
            ;;
        --continue|-c)
            CONTINUE_SESSION=true
            shift
            ;;
        --token|-t)
            CLAUDE_CODE_OAUTH_TOKEN="$2"
            export CLAUDE_CODE_OAUTH_TOKEN
            shift 2
            ;;
        --as-user)
            RUN_AS_USER=true
            RUN_AS_USER_SET=true
            shift
            ;;
        --as-rootish)
            RUN_AS_ROOTISH=true
            RUN_AS_ROOTISH_SET=true
            shift
            ;;
        --as-root|--no-rootish)
            RUN_AS_ROOTISH=false
            RUN_AS_USER=false
            RUN_AS_ROOTISH_SET=true
            RUN_AS_USER_SET=true
            shift
            ;;
        --discover-repos)
            DISCOVER_REPOS_DIRS+=("$2")
            shift 2
            ;;
        --add-repo|-a)
            ADD_REPOS+=("$2")
            shift 2
            ;;
        --config|-C)
            CONFIG_FILE="$2"
            shift 2
            ;;
        --no-run)
            NO_RUN=true
            shift
            ;;
        --shell|--bash)
            SHELL_ONLY=true
            shift
            ;;
        --bash-exec)
            BASH_EXEC="$2"
            shift 2
            ;;
        --docker)
            ENABLE_DOCKER=true
            ENABLE_DOCKER_SET=true
            shift
            ;;
        --no-interactive)
            NO_INTERACTIVE=true
            shift
            ;;
        --no-config)
            NO_CONFIG=true
            NO_CONFIG_SET=true
            shift
            ;;

        # Session management actions (use with --session)
        --delete)
            _set_action "delete"
            shift
            ;;
        --repair)
            _set_action "repair"
            shift
            ;;
        --restart)
            _set_action "restart"
            shift
            ;;
        --import)
            _set_action "import"
            IMPORT_SOURCE="$2"
            shift 2
            ;;
        --from)
            FROM_BRANCH="$2"
            shift 2
            ;;
        --auto-merge)
            AUTO_MERGE=true
            # Optional branch argument (default: main)
            if [[ -n "${2:-}" ]] && [[ ! "$2" =~ ^- ]]; then
                AUTO_MERGE_BRANCH="$2"
                shift 2
            else
                shift
            fi
            ;;
        --force-reconcile)
            export FORCE_CONTAINER_REPLACE=1
            shift
            ;;
        --clone-from)
            CLONE_FROM="$2"
            shift 2
            ;;
        --dirty)
            DIRTY_SESSION=true
            shift
            ;;
        --port|-p)
            EXPOSE_PORTS+=("$2")
            shift 2
            ;;

        --ephemeral)
            EPHEMERAL=true
            shift
            ;;
        --rebuild)
            REBUILD_CONTAINER=true
            shift
            ;;

        # Actions without session requirement
        --cleanup)
            _set_action "cleanup"
            shift
            ;;
        --cleanup-unused)
            _set_action "cleanup-unused"
            shift
            ;;

        --remove-undiscovered)
            REMOVE_UNDISCOVERED=true
            shift
            ;;

        # Action modifiers
        --force|-f)
            ACTION_FORCE=true
            shift
            ;;
        --yes|-y)
            ACTION_YES=true
            shift
            ;;
        --regex|-r)
            ACTION_REGEX=true
            shift
            ;;

        --dockerfile)
            # Specify explicit Dockerfile path or directory containing one
            DOCKERFILE_SET=true
            if [[ -n "${2:-}" ]] && [[ ! "$2" =~ ^- ]]; then
                if [[ -d "$2" ]]; then
                    # Directory given — search for Dockerfile
                    if [[ -f "$2/Dockerfile" ]]; then
                        DOCKERFILE="$2/Dockerfile"
                    elif [[ -f "$2/dockerfile" ]]; then
                        DOCKERFILE="$2/dockerfile"
                    else
                        error "No Dockerfile found in: $2"
                        exit 1
                    fi
                else
                    DOCKERFILE="$2"
                fi
                shift 2
            else
                shift
            fi
            ;;
        --version|-V)
            echo "claude-container $VERSION"
            exit 0
            ;;
        --)
            # All remaining args go to claude
            shift
            CLAUDE_ARGS=("$@")
            break
            ;;
        --help|-h)
            cat <<EOF
Usage: claude-container [options] [-- <claude-args>]
       claude-container <subcommand> [options]

Spawn into a Docker container with Claude Code ready.

Subcommands (data transfer):
  push -s <session> [branch]    Push host changes into session (host → container)
                                Run 'claude-container push --help' for details
  pull -s <session> [branch]    Pull session changes to host (container → host)
                                Run 'claude-container pull --help' for details
  status -s <session> [branch]  Check sync state (read-only)
                                Run 'claude-container status --help' for details
  remove -s <session> --include  Remove repos from a session
                                Run 'claude-container remove --help' for details
  image [-s <session>]          Show Docker image for a session
                                Run 'claude-container image --help' for details

Options:
  --session, -s <name>     Session name (required for git sessions)
  --from <branch>          Create session from specific branch
  --add-repo, -a <path>    Add a git repository to the session (can use multiple times)
  --discover-repos <dir>   Auto-discover all git repos in directory
  --config, -C <path>      Path to .claude-projects.yml config file
  --continue, -c           Continue the most recent Claude conversation
  --no-git-session         Disable git-based isolation (mount cwd directly)
  --config-only            Generate config file only, don't create session
  --dockerfile [path]      Use Dockerfile (auto-detected, or set in config)
  --token, -t <token>      Provide OAuth token directly
  --as-user                Run as non-root developer user (no sudo)
  --as-rootish             Run as developer with passwordless sudo (default)
  --as-root, --no-rootish  Run as actual root user
  --shell, --bash          Start bash shell instead of claude
  --bash-exec <cmd>        Execute a bash command and exit
  --docker                 Mount Docker socket for host Docker access
  --no-interactive         Exit with error if no token found
  --no-config              Skip auto-discovery of .claude-projects.yml
  --dirty                  Capture uncommitted host changes into session as WIP commit
  --port, -p <port>        Expose a port (e.g., --port 3000, --port 8080:80). Persisted.
  --ephemeral              Destroy container on exit (non-persistent)
  --rebuild                Force-remove existing container and create fresh
  --no-run                 Set up session but don't start container
  --verify, -v             Verify container setup works
  --version, -V            Show version
  --help, -h               Show this help

Arguments:
  -- <claude-args>         Pass remaining arguments to claude (e.g., -p, --print)

Session Management (use with -s <session>):
  --delete                 Delete session volumes
  --repair                 Fix corrupted session config
  --restart                Restart session (fixes permissions)
  --import <path>          Import claude session data from path
  --clone-from <session>   Clone all volumes from existing session
  --remove-undiscovered    With push --discover-repos: remove stale repos

  Modifiers: --force/-f, --yes/-y, --regex/-r

Global Commands (no session required):
  list                     List all sessions (use --sizes for disk usage)
  --cleanup                List and optionally delete all volumes
  --cleanup-unused         Delete unused volumes [--yes]

Examples:
  # Single project
  claude-container -s myproj

  # Multiple projects
  claude-container -s myproj -a ~/repo1 -a ~/repo2

  # Auto-discover repos in a directory
  claude-container -s myproj --discover-repos ~/dev

  # Resume session and continue conversation
  claude-container -s myproj --continue

  # Pull session changes to host
  claude-container pull -s myproj

  # Pull and merge into main
  claude-container pull -s myproj main

  # Push host changes into session (fast-forward)
  claude-container push -s myproj main

  # Check sync state
  claude-container status -s myproj

  # Start session with uncommitted changes from host
  claude-container -s myproj --dirty

  # Delete a session
  claude-container -s myproj --delete --yes

  # Run claude in print mode
  claude-container -s myproj -- -p "What is this?"

Workflow:
  1. Start session:      claude-container -s myproj
  2. Do work in container...
  3. Exit container:     exit
  4. Pull to host:       claude-container pull -s myproj main
  5. Push updates back:  claude-container push -s myproj main
  6. Check sync state:   claude-container status -s myproj main
EOF
            exit 0
            ;;
        *)
            error "Unknown option: $1"
            echo "Run 'claude-container --help' for usage"
            exit 1
            ;;
    esac
done

# Handle actions that don't require a session
case "$ACTION" in
    cleanup)
        session_cleanup
        exit 0
        ;;
    cleanup-unused)
        $ACTION_YES && session_cleanup_unused --yes || session_cleanup_unused
        exit 0
        ;;
esac

# Handle actions that require a session name
if [[ -n "$ACTION" ]]; then
    if [[ -z "$SESSION_NAME" ]]; then
        error "Session name required: use --session <name> with --$ACTION"
        exit 1
    fi

    case "$ACTION" in
        delete)
            delete_args=("$SESSION_NAME")
            $ACTION_REGEX && delete_args+=(--regex)
            $ACTION_YES && delete_args+=(--yes)
            session_delete "${delete_args[@]}"
            exit 0
            ;;
        repair)
            session_repair "$SESSION_NAME"
            exit 0
            ;;
        restart)
            session_restart "$SESSION_NAME" "$0"
            exit 0
            ;;
        import)
            if [[ -z "$IMPORT_SOURCE" ]]; then
                error "--import requires a source path"
                exit 1
            fi
            $ACTION_FORCE && session_import "$IMPORT_SOURCE" "$SESSION_NAME" --force || session_import "$IMPORT_SOURCE" "$SESSION_NAME"
            exit 0
            ;;
    esac
fi

# Validate --clone-from requires --session
if [[ -n "$CLONE_FROM" ]] && [[ -z "$SESSION_NAME" ]]; then
    error "--clone-from requires --session <name>"
    exit 1
fi

# Validate session name is provided when required
if ($USE_GIT_SESSION || $CONFIG_ONLY || [[ ${#ADD_REPOS[@]} -gt 0 ]]) && [[ -z "$SESSION_NAME" ]]; then
    error "Session name required: use --session <name>"
    exit 1
fi

# Validate --add-repo requires git session mode
if [[ ${#ADD_REPOS[@]} -gt 0 ]] && ! $USE_GIT_SESSION; then
    error "--add-repo requires git session mode (use --session)"
    exit 1
fi

# Ensure session config directory exists
mkdir -p "$SESSIONS_CONFIG_DIR"

# Load persisted session metadata (CLI flags override saved values)
if [[ -n "$SESSION_NAME" ]] && [[ -f "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env" ]]; then
    _saved_ports=()
    while IFS='=' read -r _meta_key _meta_value; do
        [[ -z "$_meta_key" || "$_meta_key" =~ ^# ]] && continue
        case "$_meta_key" in
            NO_CONFIG)      $NO_CONFIG_SET      || NO_CONFIG="$_meta_value" ;;
            RUN_AS_USER)    $RUN_AS_USER_SET     || RUN_AS_USER="$_meta_value" ;;
            RUN_AS_ROOTISH) $RUN_AS_ROOTISH_SET  || RUN_AS_ROOTISH="$_meta_value" ;;
            ENABLE_DOCKER)  $ENABLE_DOCKER_SET   || ENABLE_DOCKER="$_meta_value" ;;
            DOCKERFILE)     $DOCKERFILE_SET      || DOCKERFILE="$_meta_value" ;;
            EPHEMERAL)      EPHEMERAL="$_meta_value" ;;
            EXPOSE_PORT)    _saved_ports+=("$_meta_value") ;;
        esac
    done < "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env"
    # CLI --port flags override saved ports; if none given, use saved
    if [[ ${#EXPOSE_PORTS[@]} -eq 0 && ${#_saved_ports[@]} -gt 0 ]]; then
        EXPOSE_PORTS=("${_saved_ports[@]}")
    fi
fi

# Ensure token is available (from config, keychain, or interactive auth)
ensure_token

# Auto-discover config file if not explicitly set
if [[ -z "$CONFIG_FILE" ]] && $USE_GIT_SESSION && ! $NO_CONFIG; then
    workspace="${WORKSPACE_DIR:-$(pwd)}"
    for candidate in \
        "$workspace/.claude-projects.yml" \
        "$workspace/.devcontainer/claude-projects.yml" \
        "$workspace/claude-projects.yml"; do
        if [[ -f "$candidate" ]]; then
            CONFIG_FILE="$candidate"
            break
        fi
    done
fi

# Check for YAML parser if we'll need it (multi-project mode)
if [[ -n "$CONFIG_FILE" ]]; then
    if ! check_yaml_parser_available; then
        echo ""
        warn "Config file found but YAML parser not available"
        show_yaml_parser_install_help
        exit 1
    fi
fi

# Determine image to use
# Priority: 1. --dockerfile flag, 2. config file dockerfile field, 3. local Dockerfile, 4. default image
if [[ -z "$DOCKERFILE" ]]; then
    # Check config file for dockerfile field
    if [[ -n "${CONFIG_FILE:-}" ]] && command -v yq &>/dev/null; then
        config_dockerfile=$(yq eval '.dockerfile // ""' "$CONFIG_FILE" 2>/dev/null || echo "")
        if [[ -n "$config_dockerfile" ]]; then
            # Resolve relative to config file location
            if [[ "$config_dockerfile" != /* ]]; then
                config_dir=$(dirname "$CONFIG_FILE")
                DOCKERFILE="$config_dir/$config_dockerfile"
            else
                DOCKERFILE="$config_dockerfile"
            fi
        fi
    fi
fi

if [[ -z "$DOCKERFILE" ]]; then
    # Search for Dockerfile in standard locations
    for candidate in "./Dockerfile" "./.devcontainer/Dockerfile" "./docker/Dockerfile"; do
        if [[ -f "$candidate" ]]; then
            DOCKERFILE="$candidate"
            break
        fi
    done
fi

if [[ -n "$DOCKERFILE" ]]; then
    if [[ ! -f "$DOCKERFILE" ]]; then
        error "Dockerfile not found: $DOCKERFILE"
        exit 1
    fi
    # Resolve to absolute path so session metadata is meaningful
    DOCKERFILE="$(cd "$(dirname "$DOCKERFILE")" && pwd)/$(basename "$DOCKERFILE")"
    USE_DEFAULT_IMAGE=false
else
    # No local Dockerfile found, use default image
    USE_DEFAULT_IMAGE=true
    IMAGE_NAME="$DEFAULT_IMAGE"
fi

if $USE_DEFAULT_IMAGE; then
    IMAGE_EXISTS=$(docker images -q "$IMAGE_NAME" 2>/dev/null)
    if [[ -z "$IMAGE_EXISTS" ]]; then
        info "Pulling image: $IMAGE_NAME"
        docker pull "$IMAGE_NAME" &
        spin $!
        wait $!
        success "Image pulled: $IMAGE_NAME"
        echo ""
    fi
else
    info "Using Dockerfile: $DOCKERFILE"
    CONTEXT_DIR="$(dirname "$DOCKERFILE")"
    if [[ "$CONTEXT_DIR" == "." ]]; then
        CONTEXT_DIR="$(pwd)"
    fi
    PROJECT_NAME="$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]-')"
    IMAGE_NAME="claude-dev-${PROJECT_NAME}"

    # Check if image needs rebuilding (doesn't exist or Dockerfile is newer)
    IMAGE_EXISTS=$(docker images -q "$IMAGE_NAME" 2>/dev/null)
    NEEDS_BUILD=false
    if [[ -z "$IMAGE_EXISTS" ]]; then
        NEEDS_BUILD=true
    else
        # Compare epoch seconds: image creation vs Dockerfile modification
        IMAGE_EPOCH=$(date -j -f "%Y-%m-%dT%H:%M:%S" \
            "$(docker inspect -f '{{.Created}}' "$IMAGE_NAME" 2>/dev/null | cut -d'.' -f1)" \
            +%s 2>/dev/null \
            || docker inspect -f '{{.Created}}' "$IMAGE_NAME" 2>/dev/null \
            | xargs -I{} date -d {} +%s 2>/dev/null \
            || echo "0")
        DOCKERFILE_EPOCH=$(stat -f %m "$DOCKERFILE" 2>/dev/null \
            || stat -c %Y "$DOCKERFILE" 2>/dev/null \
            || echo "0")
        if [[ "$DOCKERFILE_EPOCH" -gt "$IMAGE_EPOCH" ]]; then
            NEEDS_BUILD=true
        fi
    fi

    if $NEEDS_BUILD; then
        info "Building image: $IMAGE_NAME"
        docker build -t "$IMAGE_NAME" -f "$DOCKERFILE" "$CONTEXT_DIR" &
        spin $!
        wait $!
        success "Image built: $IMAGE_NAME"
        echo ""
    fi
fi

# Prepare mount points
WORKSPACE_DIR="$(pwd)"
USE_OVERLAY=false

# Handle session directory with overlay (deprecated)
SESSION_VOLUME=""
if [[ -n "$SESSION_DIR" ]]; then
    warn "The --dir option is deprecated. Use --session instead."
    SESSION_DIR="$(cd "$SESSION_DIR" && pwd)"
    SESSION_UUID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    SESSION_VOLUME="session-data-${SESSION_UUID}"
    info "Creating session volume: $SESSION_VOLUME"
    docker volume create "$SESSION_VOLUME" >/dev/null
    USE_OVERLAY=true
    WORKSPACE_DIR="$SESSION_DIR"
fi

# Handle --config-only: generate config and exit
if $CONFIG_ONLY; then
    if [[ ${#DISCOVER_REPOS_DIRS[@]} -gt 0 ]]; then
        # Discover repos and write config to session config dir
        discovered_config=$(discover_repos_multi "${DISCOVER_REPOS_DIRS[@]}")
        session_config="$SESSIONS_CONFIG_DIR/${SESSION_NAME}.yml"
        cp "$discovered_config" "$session_config"
        rm -f "$discovered_config"
        success "Config written to: $session_config"
        echo "$session_config"
        exit 0
    elif [[ -n "${CONFIG_FILE:-}" ]]; then
        # Copy provided config to session config dir
        session_config="$SESSIONS_CONFIG_DIR/${SESSION_NAME}.yml"
        cp "$CONFIG_FILE" "$session_config"
        success "Config copied to: $session_config"
        echo "$session_config"
        exit 0
    else
        error "--config-only requires --discover-repos or --config"
        exit 1
    fi
fi

# Handle git-based session isolation (recommended)
GIT_SESSION_VOLUME=""
if $USE_GIT_SESSION; then
    GIT_SESSION_VOLUME="claude-session-${SESSION_NAME}"

    # If --discover-repos was specified, write config to session config dir first
    if [[ ${#DISCOVER_REPOS_DIRS[@]} -gt 0 ]]; then
        discovered_config=$(discover_repos_multi "${DISCOVER_REPOS_DIRS[@]}")
        session_config="$SESSIONS_CONFIG_DIR/${SESSION_NAME}.yml"
        cp "$discovered_config" "$session_config"
        rm -f "$discovered_config"
        CONFIG_FILE="$session_config"
        info "Session config: $session_config"
    fi

    # Track whether session already exists (for --discover-repos on re-entry)
    _session_existed=false
    if docker volume inspect "$GIT_SESSION_VOLUME" &>/dev/null; then
        _session_existed=true
    fi

    # Handle --clone-from: clone volumes from existing session if target doesn't exist
    if [[ -n "$CLONE_FROM" ]] && ! $_session_existed; then
        session_clone "$CLONE_FROM" "$SESSION_NAME"
    elif $_session_existed && [[ ${#DISCOVER_REPOS_DIRS[@]} -gt 0 ]]; then
        # Session exists + --discover-repos: skip create_git_session (it would
        # re-discover and print the full repo list again). Just add new repos below.
        info "Resuming existing multi-project session: $SESSION_NAME"
    else
        create_git_session "$SESSION_NAME" "$WORKSPACE_DIR"
    fi

    # If --discover-repos was used on an existing session, add any new repos
    # (create_multi_project_session returns early for existing volumes, so
    # discovered repos would be silently dropped without this)
    if $_session_existed && [[ ${#DISCOVER_REPOS_DIRS[@]} -gt 0 ]]; then
        _disc_config="$SESSIONS_CONFIG_DIR/${SESSION_NAME}.yml"
        if [[ -f "$_disc_config" ]]; then
            # Build name|path pairs from discovered config
            _bulk_repos=""
            while IFS='|' read -r _dname _dpath _dbranch _dtrack _dsource; do
                [[ -z "$_dname" ]] && continue
                _bulk_repos+="$_dname|$_dpath"$'\n'
            done <<< "$(parse_config_file "$_disc_config")"
            session_add_repos_bulk "$SESSION_NAME" "$_bulk_repos"
        fi
    fi

    # Persist session metadata so resuming only needs: claude-container -s <name>
    cat > "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env" << EOF
# Session metadata for claude-container (auto-generated)
NO_CONFIG=$NO_CONFIG
RUN_AS_USER=$RUN_AS_USER
RUN_AS_ROOTISH=$RUN_AS_ROOTISH
ENABLE_DOCKER=$ENABLE_DOCKER
DOCKERFILE=${DOCKERFILE:-}
EPHEMERAL=$EPHEMERAL
EOF
    # Append port mappings (multi-value, one per line)
    for _port in "${EXPOSE_PORTS[@]}"; do
        echo "EXPOSE_PORT=$_port" >> "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env"
    done

    # Handle --add-repo: add repos to session (works for both new and existing sessions)
    if [[ ${#ADD_REPOS[@]} -gt 0 ]]; then
        for repo_path in "${ADD_REPOS[@]}"; do
            session_add_repo "$SESSION_NAME" "$repo_path"
        done
    fi

    if $NO_RUN; then
        success "Session ready: $SESSION_NAME"
        exit 0
    fi
fi

# Touch session metadata to track last-opened time
if [[ -n "$SESSION_NAME" && -f "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env" ]]; then
    touch "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env"
fi

# Determine container name (must be set before DOCKER_ARGS)
CONTAINER_NAME="claude-dev-$$"
if $USE_GIT_SESSION && ! $EPHEMERAL && [[ -n "$SESSION_NAME" ]]; then
    CONTAINER_NAME="claude-session-ctr-${SESSION_NAME}"
fi

# Build docker run command
DOCKER_ARGS=()
if $EPHEMERAL || ! $USE_GIT_SESSION; then
    DOCKER_ARGS+=("--rm")
fi
DOCKER_ARGS+=(
    "--name" "$CONTAINER_NAME"
    "-w" "/workspace"
)

# Add TTY based on CI detection and terminal availability
if $IS_CI; then
    :
elif ! $VERIFY_MODE && [[ -t 0 ]]; then
    DOCKER_ARGS+=("-it")
fi

# Mount workspace
if $USE_GIT_SESSION; then
    DOCKER_ARGS+=("-v" "$GIT_SESSION_VOLUME:/workspace")
elif $USE_OVERLAY; then
    DOCKER_ARGS+=(
        "--privileged"
        "--device" "/dev/fuse"
        "-v" "$WORKSPACE_DIR:/workspace-lower:ro"
        "-v" "$SESSION_VOLUME:/session-data"
        "-e" "USE_OVERLAY=1"
        "-e" "SESSION_VOLUME=$SESSION_VOLUME"
    )
else
    DOCKER_ARGS+=("-v" "$WORKSPACE_DIR:/workspace")
fi

# Mount git config and SSH
DOCKER_ARGS+=(
    "-v" "$HOME/.gitconfig:/root/.gitconfig:ro"
    "-v" "$HOME/.ssh:/root/.ssh:ro"
)

# Forward SSH agent if available
SSH_SOCKET_ARGS=$(get_ssh_socket_args)
if [[ -n "$SSH_SOCKET_ARGS" ]]; then
    # shellcheck disable=SC2086
    DOCKER_ARGS+=($SSH_SOCKET_ARGS)
fi

# Read .merge-into-mounts marker from volume (written by session_merge_into for exec-back)
if $USE_GIT_SESSION && [[ ${#EXTRA_DOCKER_ARGS[@]} -eq 0 ]]; then
    _mounts_content=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
        cat /session/.merge-into-mounts 2>/dev/null || echo "")
    if [[ -n "$_mounts_content" ]]; then
        while IFS='|' read -r _mount_name _mount_path; do
            [[ -z "$_mount_name" ]] && continue
            [[ -z "$_mount_path" ]] && continue
            EXTRA_DOCKER_ARGS+=("-v" "$_mount_path:/host/$_mount_name:ro")
        done <<< "$_mounts_content"
    fi
fi

# Append extra docker args from pre-startup actions (e.g. merge-into host repo mounts)
if [[ ${#EXTRA_DOCKER_ARGS[@]} -gt 0 ]]; then
    DOCKER_ARGS+=("${EXTRA_DOCKER_ARGS[@]}")
fi

# Expose ports
for _port in "${EXPOSE_PORTS[@]}"; do
    # Support both "3000" (→ 3000:3000) and "8080:80" (→ 8080:80) formats
    if [[ "$_port" == *:* ]]; then
        DOCKER_ARGS+=("-p" "$_port")
    else
        DOCKER_ARGS+=("-p" "$_port:$_port")
    fi
done

# Add environment variables
DOCKER_ARGS+=(
    "-e" "TERM=${TERM:-xterm-256color}"
    "-e" "HOST_UID=$(get_host_uid)"
    "-e" "HOST_GID=$(get_host_gid)"
    "-e" "PLATFORM=$PLATFORM"
    "-e" "IS_CI=$IS_CI"
)

# Inject token securely
inject_token_securely "${CLAUDE_CODE_OAUTH_TOKEN}"

# Set up session state and dev caches
setup_session_state "$SESSION_NAME"
setup_dev_caches "$SESSION_NAME"

if $VERIFY_MODE; then
    DOCKER_ARGS+=("-e" "VERIFY_MODE=1")
fi

if $CONTINUE_SESSION; then
    DOCKER_ARGS+=("-e" "CONTINUE_SESSION=1")
fi

if $RUN_AS_USER; then
    DOCKER_ARGS+=("-e" "RUN_AS_USER=1")
fi

if $RUN_AS_ROOTISH; then
    DOCKER_ARGS+=("-e" "RUN_AS_ROOTISH=1")
fi

if $SHELL_ONLY; then
    DOCKER_ARGS+=("-e" "SHELL_ONLY=1")
fi

if [[ -n "$BASH_EXEC" ]]; then
    DOCKER_ARGS+=("-e" "BASH_EXEC=$BASH_EXEC")
fi

# Pass session name for statusline display
DOCKER_ARGS+=("-e" "CLAUDE_SESSION_NAME=$SESSION_NAME")

# Agent abstraction layer env vars
DOCKER_ARGS+=("-e" "AGENT_TASK=${AGENT_TASK:-work}")
if [[ -n "${AGENT_CONTEXT:-}" ]]; then
    DOCKER_ARGS+=("-e" "AGENT_CONTEXT=$AGENT_CONTEXT")
fi

# Mount entrypoint and agent-run scripts
DOCKER_ARGS+=(
    "-v" "$SCRIPT_DIR/lib/container/entrypoint.sh:/usr/local/bin/cc-entrypoint:ro"
    "-v" "$SCRIPT_DIR/lib/container/agent-run.sh:/usr/local/bin/agent-run:ro"
)

# Always start as root — the entrypoint handles privilege drop via gosu.
# Custom Dockerfiles may set USER developer, but the entrypoint needs root
# to create users, fix permissions, and set up the environment.
DOCKER_ARGS+=("--user" "0:0")

# Pass through claude args if provided
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
    # Serialize the array as a base64-encoded string to preserve spaces and special chars
    CLAUDE_PASSTHROUGH_ARGS=$(printf '%s\n' "${CLAUDE_ARGS[@]}" | base64 -w 0 2>/dev/null || printf '%s\n' "${CLAUDE_ARGS[@]}" | base64)
    DOCKER_ARGS+=("-e" "CLAUDE_PASSTHROUGH_ARGS=$CLAUDE_PASSTHROUGH_ARGS")
fi

if $ENABLE_DOCKER; then
    # Verify Docker is accessible from host
    DOCKER_AVAILABLE=false
    if command -v docker &>/dev/null; then
        DOCKER_HOST_URL=$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null)
        if [[ -n "$DOCKER_HOST_URL" ]] && [[ "$DOCKER_HOST_URL" == unix://* ]]; then
            HOST_SOCKET="${DOCKER_HOST_URL#unix://}"
            if [[ -S "$HOST_SOCKET" ]]; then
                DOCKER_AVAILABLE=true
            fi
        fi
    fi

    if $DOCKER_AVAILABLE; then
        # Mount the VM-side socket (works for Colima/Docker Desktop on macOS)
        DOCKER_ARGS+=("-v" "/var/run/docker.sock:/var/run/docker.sock")
        DOCKER_ARGS+=("-e" "DOCKER_HOST=unix:///var/run/docker.sock")
        if [[ "$PLATFORM" == "linux" ]]; then
            warn "Docker socket mounted - this grants full Docker access"
            warn "On Linux, this is equivalent to root access on the host"
        else
            info "Docker socket mounted (VM: /var/run/docker.sock)"
        fi
    else
        warn "Could not find Docker socket - --docker will not work"
        if command -v docker &>/dev/null; then
            warn "Active context: $(docker context show 2>/dev/null || echo 'unknown')"
        fi
    fi
fi

info "Starting container..."
echo "  Image: $IMAGE_NAME"
if [[ -n "${DOCKERFILE:-}" ]]; then
    echo "  Dockerfile: $DOCKERFILE"
fi
if $USE_GIT_SESSION; then
    echo "  Workspace: $GIT_SESSION_VOLUME -> /workspace (git session)"
else
    echo "  Workspace: $WORKSPACE_DIR -> /workspace"
fi
echo "  Platform: $PLATFORM"
echo "  State: claude-state-${SESSION_NAME}"
if $IS_CI; then
    echo "  CI Mode: enabled"
fi
if $USE_OVERLAY; then
    echo "  Session: $SESSION_VOLUME (overlay mode - deprecated)"
fi
if $USE_GIT_SESSION; then
    echo "  Git Session: $SESSION_NAME"
fi
if $ENABLE_DOCKER && ${DOCKER_AVAILABLE:-false}; then
    echo "  Docker: enabled (/var/run/docker.sock)"
fi
if [[ ${#EXPOSE_PORTS[@]} -gt 0 ]]; then
    echo "  Ports: ${EXPOSE_PORTS[*]}"
fi
echo ""

# Update .main-project based on cwd before every launch
# (get_main_project tries: main:true, cwd match, session name match, first key)
if $USE_GIT_SESSION && [[ -n "$SESSION_NAME" ]] && docker volume inspect "$GIT_SESSION_VOLUME" &>/dev/null; then
    _resolved_main=""
    _session_cfg=$(docker run --rm --entrypoint sh \
        -v "$GIT_SESSION_VOLUME:/session:ro" "${GIT_UTIL_IMAGE:-alpine/git}" \
        -c 'cat /session/.claude-projects.yml' 2>/dev/null || true)
    if [[ -n "$_session_cfg" ]] && command -v yq &>/dev/null; then
        _cwd=$(pwd)
        # Match cwd against project paths
        while IFS='|' read -r _pname _ppath; do
            [[ -z "$_ppath" ]] && continue
            if [[ "$_cwd" == "$_ppath" || "$_cwd" == "$_ppath"/* ]]; then
                _resolved_main="$_pname"
                break
            fi
        done <<< "$(echo "$_session_cfg" | yq eval '.projects | to_entries | .[] | .key + "|" + .value.path' - 2>/dev/null)" || true

        # Match session name against project names
        if [[ -z "$_resolved_main" ]]; then
            while IFS= read -r _pname; do
                [[ -z "$_pname" ]] && continue
                if [[ "${_pname##*/}" == "$SESSION_NAME" || "$_pname" == *"/$SESSION_NAME" ]]; then
                    _resolved_main="$_pname"
                    break
                fi
            done <<< "$(echo "$_session_cfg" | yq eval '.projects | keys | .[]' - 2>/dev/null)" || true
        fi
    fi
    if [[ -n "$_resolved_main" ]]; then
        _current_main=$(docker run --rm --entrypoint sh \
            -v "$GIT_SESSION_VOLUME:/session:ro" "${GIT_UTIL_IMAGE:-alpine/git}" \
            -c 'cat /session/.main-project 2>/dev/null' 2>/dev/null || true)
        if [[ "$_current_main" != "$_resolved_main" ]]; then
            docker run --rm --entrypoint sh \
                --user "$(id -u):$(id -u)" \
                -v "$GIT_SESSION_VOLUME:/session" \
                "${GIT_UTIL_IMAGE:-alpine/git}" \
                -c "echo '$_resolved_main' > /session/.main-project" 2>/dev/null || true
            # Need fresh container to pick up new .main-project
            docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
        fi
    fi
fi

# Container reuse logic for persistent (non-ephemeral) session containers
_CONTAINER_REUSED=false
if $USE_GIT_SESSION && ! $EPHEMERAL && [[ -n "$SESSION_NAME" ]]; then
    _existing_ctr=$(docker ps -aq --filter "name=^${CONTAINER_NAME}$" 2>/dev/null || true)

    if [[ -n "$_existing_ctr" ]] && $REBUILD_CONTAINER; then
        info "Removing existing container for rebuild..."
        docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
        _existing_ctr=""
    fi

    if [[ -n "$_existing_ctr" ]]; then
        _ctr_running=$(docker ps -q --filter "name=^${CONTAINER_NAME}$" 2>/dev/null || true)
        if [[ -n "$_ctr_running" ]]; then
            # If we're launching for a specific task (reconcile, rebase, etc.),
            # we can't attach — stdin would be shared. Need explicit permission to stop.
            if [[ -n "${AGENT_TASK:-}" && "${AGENT_TASK}" != "work" ]]; then
                if [[ "${FORCE_CONTAINER_REPLACE:-}" == "1" ]]; then
                    warn "Stopping running container for '$AGENT_TASK' task..."
                    docker stop -t 5 "$CONTAINER_NAME" >/dev/null 2>&1 || true
                    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
                    _existing_ctr=""
                    # Fall through to create a new container below
                else
                    error "Session '$SESSION_NAME' has a running container."
                    echo "  The container must be stopped to launch '$AGENT_TASK'."
                    echo "  Re-run with --force-reconcile to stop it and proceed."
                    exit 1
                fi
            else
                warn "Container already running for session '$SESSION_NAME'"
                info "Attaching to running container..."
                docker attach "$CONTAINER_NAME" || true
            fi
        elif [[ -n "${AGENT_TASK:-}" && "${AGENT_TASK}" != "work" ]]; then
            # Task launch with a stopped container — remove it so we start fresh
            info "Removing stopped container for '$AGENT_TASK' task..."
            docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
            _existing_ctr=""
        else
            # Check if container was built from a different image than current
            _ctr_image=$(docker inspect --format '{{.Config.Image}}' "$CONTAINER_NAME" 2>/dev/null || echo "")
            if [[ -n "$_ctr_image" && "$_ctr_image" != "$IMAGE_NAME" ]]; then
                info "Image changed ($_ctr_image → $IMAGE_NAME) — rebuilding container..."
                docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
                _existing_ctr=""
            fi

            # Check if entrypoint mount points to a different script dir
            # (e.g. installed copy vs dev repo, or dev repo changed)
            if [[ -n "$_existing_ctr" ]]; then
                _ctr_entrypoint=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/usr/local/bin/cc-entrypoint"}}{{.Source}}{{end}}{{end}}' "$CONTAINER_NAME" 2>/dev/null || echo "")
                _expected_entrypoint="$SCRIPT_DIR/lib/container/entrypoint.sh"
                if [[ -n "$_ctr_entrypoint" && "$_ctr_entrypoint" != "$_expected_entrypoint" ]]; then
                    info "Entrypoint changed — rebuilding container..."
                    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
                    _existing_ctr=""
                fi
            fi

            # Only check mounts and resume if container still exists
            if [[ -n "$_existing_ctr" ]]; then
                # Check for corrupted mounts before resuming
                _mount_ok=true
                _mounts=""
                _mounts=$(docker inspect --format '{{range .Mounts}}{{.Source}}|{{.Type}}{{"\n"}}{{end}}' "$CONTAINER_NAME" 2>/dev/null || true)
                while IFS='|' read -r _msrc _mtype; do
                    [[ -z "$_msrc" ]] && continue
                    [[ "$_mtype" != "bind" ]] && continue
                    if [[ -d "$_msrc" && "$_msrc" == *"/token-"* ]]; then
                        warn "Corrupted mount detected: $_msrc is a directory (expected file)"
                        info "Removing stale container — a fresh one will be created..."
                        rm -rf "$_msrc"
                        docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
                        _existing_ctr=""
                        _mount_ok=false
                        break
                    fi
                done <<< "$_mounts" || true

                if $_mount_ok; then
                    info "Resuming container for session '$SESSION_NAME'..."
                    docker start -ai "$CONTAINER_NAME" || true
                fi
            fi
        fi
        # Only mark as reused if we didn't remove it for a task launch
        [[ -n "$_existing_ctr" ]] && _CONTAINER_REUSED=true
    fi
fi

# Run container with mounted entrypoint (skip if reusing existing container)
if ! $_CONTAINER_REUSED; then
docker run "${DOCKER_ARGS[@]}" "$IMAGE_NAME" /bin/bash -c 'chmod +x /usr/local/bin/cc-entrypoint /usr/local/bin/agent-run 2>/dev/null; exec /usr/local/bin/cc-entrypoint'
fi  # end: if ! $_CONTAINER_REUSED

# Session exit message
if $USE_GIT_SESSION; then
    # Update last-active timestamp
    [[ -n "$SESSION_NAME" && -f "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env" ]] && \
        touch "$SESSIONS_CONFIG_DIR/${SESSION_NAME}.env"
    echo ""

    # Read agent result from volume (written by agent-run.sh)
    _AGENT_RESULT=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
        cat /session/.agent-result 2>/dev/null || echo "")

    # Display structured exit report
    _agent_exit_report() {
        local task="${AGENT_TASK:-work}"
        local session="$SESSION_NAME"

        if [[ -z "$_AGENT_RESULT" ]]; then
            # No agent result file — agent made no commits or was shell/exec mode
            echo "──────────────────────────────────────────────────"
            echo "· Agent exited without changes"
            if [[ "$task" == "resolve-conflicts" || "$task" == "rebase-conflicts" ]]; then
                # Count expected repos from config
                local _expected_repos=""
                _expected_repos=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
                    sh -c 'ls -d /session/*/.git 2>/dev/null | wc -l' || echo "?")
                echo "  Expected: resolve conflicts in ${_expected_repos} repo(s)"
            fi
            echo "──────────────────────────────────────────────────"
        else
            # Parse agent result
            local _changed=0
            local _unchanged=0
            local _total_commits=0

            if [[ "$task" == "resolve-conflicts" || "$task" == "rebase-conflicts" ]]; then
                echo "─────────── session: $session ──────────────────────"
            else
                echo "→ Session complete: $session"
            fi
            echo ""

            while IFS='|' read -r _repo _count _head; do
                [[ "$_repo" == "---" ]] && break
                [[ -z "$_repo" ]] && continue
                if [[ "$_count" -gt 0 ]] 2>/dev/null; then
                    if [[ "$task" == "resolve-conflicts" || "$task" == "rebase-conflicts" ]]; then
                        echo "  $_repo"
                        echo "    ✓ $_count commits (resolved conflicts)"
                    else
                        echo "  $_repo"
                        echo "    $_count commits during session"
                    fi
                    _changed=$((_changed + 1))
                    _total_commits=$((_total_commits + _count))
                fi
            done <<< "$_AGENT_RESULT"

            # Show unchanged repos for conflict resolution tasks
            if [[ "$task" == "resolve-conflicts" || "$task" == "rebase-conflicts" ]]; then
                while IFS='|' read -r _repo _count _head; do
                    [[ "$_repo" == "---" ]] && break
                    [[ -z "$_repo" ]] && continue
                done <<< "$_AGENT_RESULT"
                # List repos that had no changes (need to enumerate workspace repos)
                local _all_repos
                _all_repos=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
                    sh -c 'for d in /session/*/; do [ -d "$d/.git" ] && basename "$d"; done' 2>/dev/null || echo "")
                while IFS= read -r _ws_repo; do
                    [[ -z "$_ws_repo" ]] && continue
                    if ! echo "$_AGENT_RESULT" | grep -q "^${_ws_repo}|"; then
                        echo "  $_ws_repo"
                        echo "    · no changes"
                        _unchanged=$((_unchanged + 1))
                    fi
                done <<< "$_all_repos"
            fi

            echo ""
            echo "──────────────────────────────────────────────────"
            if [[ "$task" == "resolve-conflicts" || "$task" == "rebase-conflicts" ]]; then
                echo "✓ $_changed resolved, $_unchanged unchanged"
            else
                echo "$_total_commits commits across $_changed repo(s)"
            fi
        fi
    }

    _agent_exit_report
    echo ""

    # Clean up agent result from volume
    docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
        rm -f /session/.agent-result 2>/dev/null || true

    # Check if this was a sync session
    SYNC_BRANCH_CHECK=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
        cat /session/.sync-branch 2>/dev/null || echo "")

    # Check if this was a merge-into session
    MERGE_INTO_BRANCH_CHECK=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
        cat /session/.merge-into-branch 2>/dev/null || echo "")

    if [[ -n "$SYNC_BRANCH_CHECK" ]]; then
        # Clean up sync marker and remotes
        info "Cleaning up sync remotes..."
        SYNC_CONFIG_CONTENT=$(read_session_config "$GIT_SESSION_VOLUME")

        if [[ -n "$SYNC_CONFIG_CONTENT" ]] && command -v yq &>/dev/null; then
            SYNC_PROJECTS=$(parse_session_projects "$SYNC_CONFIG_CONTENT")

            while IFS='|' read -r proj_name proj_path; do
                [[ -z "$proj_name" ]] && continue
                docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
                    sh -c "cd '/session/$proj_name' && git remote remove upstream" 2>/dev/null || true
            done <<< "$SYNC_PROJECTS"
        fi

        # Remove sync markers
        docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
            rm -f /session/.sync-branch /session/.sync-summary 2>/dev/null || true

        success "Sync cleanup complete"
        echo ""
        echo "To pull rebased changes to host:"
        echo "  claude-container pull -s $SESSION_NAME --force"

    elif [[ -n "$MERGE_INTO_BRANCH_CHECK" ]] && { [[ -n "$MERGE_INTO_BRANCH" ]] || $AUTO_MERGE; }; then
        # Check if reconcile completed via 'fin' command
        RECONCILE_RESULT=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
            cat /session/.reconcile-complete 2>/dev/null || echo "")
        if [[ -n "$RECONCILE_RESULT" ]]; then
            success "Reconcile complete: $RECONCILE_RESULT"
            docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
                rm -f /session/.reconcile-complete 2>/dev/null || true
        fi

        # Clean up merge-into marker and remotes
        info "Cleaning up merge remotes..."
        MERGE_CONFIG_CONTENT=$(read_session_config "$GIT_SESSION_VOLUME")
        MERGE_PROJECTS=$(parse_session_projects "$MERGE_CONFIG_CONTENT")

        if [[ -n "$MERGE_PROJECTS" ]]; then
            while IFS='|' read -r proj_name proj_path; do
                [[ -z "$proj_name" ]] && continue
                docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
                    sh -c "cd '/session/$proj_name' && git remote remove upstream" 2>/dev/null || true
            done <<< "$MERGE_PROJECTS"
        fi

        # Remove merge-into markers (branch, summary, mounts)
        docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
            rm -f /session/.merge-into-branch /session/.merge-into-summary /session/.merge-into-mounts 2>/dev/null || true

        success "Merge cleanup complete"
        echo ""

        # Use the unified pull flow (extract + merge + report)
        # This gives proper squash tracking, conflict reporting, and --verify support
        info "Pulling merged changes into '$MERGE_INTO_BRANCH_CHECK'..."
        echo ""

        if $AUTO_MERGE; then
            # Check for --verify marker (written by pull --reconcile --verify)
            VERIFY_MERGE=$(docker run --rm -v "$GIT_SESSION_VOLUME:/session:ro" "$IMAGE_NAME" \
                cat /session/.merge-verify 2>/dev/null || echo "")
            docker run --rm -v "$GIT_SESSION_VOLUME:/session" "$IMAGE_NAME" \
                rm -f /session/.merge-verify 2>/dev/null || true

            # Source the pull subcommand for unified reporting functions
            for _f in "$SCRIPT_DIR/lib/commands/pull/"*.sh; do
                source "$_f"
            done

            # Create unified result dir
            _EXIT_RESULT_DIR=$(mktemp -d)

            # Extract with result tracking
            session_extract "$SESSION_NAME" --force --result-dir "$_EXIT_RESULT_DIR"

            # Dry-run merge to populate results
            session_auto_merge "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" true "" true "$_EXIT_RESULT_DIR" 2>/dev/null || true

            # Always show the report (what would happen)
            echo ""
            _pull_report "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" "$_EXIT_RESULT_DIR"

            # Show diffstat
            echo ""
            _verify_diffstat "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" "$_EXIT_RESULT_DIR" || true

            if [[ -n "$VERIFY_MERGE" ]]; then
                # --verify: ask before merging
                echo ""
                printf "Merge into '%s'? [y/N] " "$MERGE_INTO_BRANCH_CHECK"
                read -r _verify_answer
                case "$_verify_answer" in
                    [yY]|[yY][eE][sS])
                        info "Merging..."
                        session_auto_merge "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" false "" true "$_EXIT_RESULT_DIR" || true
                        echo ""
                        _pull_report "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" "$_EXIT_RESULT_DIR"
                        ;;
                    [sS])
                        info "Session branches extracted, merge skipped."
                        info "To merge later: claude-container pull -s $SESSION_NAME $MERGE_INTO_BRANCH_CHECK"
                        ;;
                    *)
                        info "Aborted. Session branches extracted but not merged."
                        info "To merge later: claude-container pull -s $SESSION_NAME $MERGE_INTO_BRANCH_CHECK"
                        ;;
                esac
            else
                # No verify — merge immediately and show final report
                session_auto_merge "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" false "" true "$_EXIT_RESULT_DIR" || true
                echo ""
                _pull_report "$SESSION_NAME" "$MERGE_INTO_BRANCH_CHECK" "$_EXIT_RESULT_DIR"
            fi

            rm -rf "$_EXIT_RESULT_DIR"
        else
            echo "To merge into $MERGE_INTO_BRANCH_CHECK:"
            echo "  claude-container pull -s $SESSION_NAME $MERGE_INTO_BRANCH_CHECK"
        fi

        # Check for reconcile continuation
        if [[ -f "$CONFIG_DIR/.reconcile-plan" ]]; then
            echo ""
            info "Continuing reconcile..."
            exec "$0" reconcile --continue
        fi
    else
        echo "To pull: claude-container pull -s $SESSION_NAME"
    fi
fi
